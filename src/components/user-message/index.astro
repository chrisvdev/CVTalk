---
// Asegurar que baseUrl siempre termine con /
let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) {
  baseUrl = baseUrl + '/';
}
---

<template id="user-message" class="user-message">
  <img id="primaryBagde" />
  <div>
    <div class="avatarOrnament">
      <img id="avatar" />
      <img id="defaultAvatar" src={`${baseUrl}assets/st-chrisvdev.gif`} />
    </div>
    <span id="displayName"> </span>
  </div>
  <div class="messageOrnament">
    <div>
      <div id="secondaryBadges"></div>
      <span class="message"></span>
    </div>
  </div>
</template>

<script src="./index.ts"></script>
