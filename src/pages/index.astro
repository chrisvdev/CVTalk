---
import ChatView from "@components/chat-view/index.astro";
import UserMessage from "@components/user-message/index.astro";
import { ensureTrailingSlash } from "@/lib/ensure_trailing_slash";

const baseUrl = ensureTrailingSlash(import.meta.env.BASE_URL);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href={`${baseUrl}assets/styles/index.css`} />
    <script define:vars={{ baseUrl }}>
      // Inyectar BASE_URL en el sistema global tipado OBSChat
      // Este script se ejecuta antes de global.ts, por lo que inicializa la propiedad
      window.OBSChat = window.OBSChat || {};
      window.OBSChat.properties = window.OBSChat.properties || {};
      window.OBSChat.properties.baseUrl = baseUrl;
    </script>
    <script src="@/scripts/global.ts"></script>
    <title>CVTalk - OBS Chat Widget</title>
  </head>
  <body>
    <UserMessage />
    <ChatView />
    <script src="@/scripts/start.ts"></script>
  </body>
</html>
