---
import ChatView from "@components/chat-view/index.astro";
import UserMessage from "@components/user-message/index.astro";

// Asegurar que baseUrl siempre termine con /
let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) {
  baseUrl = baseUrl + '/';
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href={`${baseUrl}assets/styles/index.css`} />
    <script define:vars={{ baseUrl }}>
      // Inyectar BASE_URL globalmente para uso en scripts TypeScript
      window.__BASE_URL__ = baseUrl;
    </script>
    <script src="@/scripts/global.ts"></script>
    <title>CVTalk - OBS Chat Widget</title>
  </head>
  <body>
    <UserMessage />
    <ChatView />
    <script src="@/scripts/start.ts"></script>
  </body>
</html>
